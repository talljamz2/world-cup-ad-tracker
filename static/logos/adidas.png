        "logged_in": "FALSE", // Optional
        "site_name": "ADIDAS",
        "page_name": "REGULAR 403 ERROR", // Or "CPR 403 ERROR"
        "page_owner": "AKAMAI", 
        "page_type": "ERROR",
    };

(function (a, b, c, d) {
    a = '//tags.tiqcdn.com/utag/adidas/adidasglobal/prod/utag.js';
    b = document;
    c = 'script';
    d = b.createElement(c);
    d.src = a;
    d.type = 'text/java' + c;
    d.async = true;
    a = b.getElementsByTagName(c)[0];
